# Rabbit Hole configuration (PROJECT_SPEC section 11).
#
# Copy to `.env` and edit. `.env` is gitignored; never commit real values.
# Secrets stay empty here. As of M1 no code reads these variables yet; the
# comment above each group names the milestone that wires it in. Budget
# defaults are added with the agent loop in M2.

# --- Policy model: local OpenAI-compatible server (default; M1 probe, M5) ---
# Provider used by `arp run` and live evals: local | hosted | scripted | replay.
ARP_PROVIDER=local
# llama.cpp `llama-server` (pinned in docs/local-models.md). Ollama would be
# http://127.0.0.1:11434/v1 instead.
ARP_LLM_BASE_URL=http://127.0.0.1:8080/v1
# Model name sent in requests; llama-server reports the GGUF file name.
ARP_LOCAL_MODEL=Qwen3-1.7B-Q4_K_M.gguf
# Context length the server was started with (llama-server -c).
ARP_LOCAL_CTX=4096
# Tool-call format: native | json. Left empty until the M1 probe picks the
# default under its pre-registered rule (PLAN M1).
ARP_TOOL_FORMAT=
# Memory preflight headroom in MB on top of GGUF size + KV cache (`arp doctor`).
ARP_MIN_FREE_MB=1024

# --- Runaway guard, all providers (M5) ---
ARP_MAX_CONSECUTIVE_FAILURES=3
ARP_MAX_RETRIES_PER_RUN=20

# --- Optional hosted backend (M5; unused while Cline is paused, ADR-0009) ---
# Every hosted run is "not run" in reports and the README.
ARP_HOSTED_BASE_URL=
# Allowlist: cline-pass/deepseek-v4.1-flash
ARP_HOSTED_MODEL=
# Name of the environment variable that holds the API key (not the key).
ARP_HOSTED_API_KEY_ENV=CLINE_API_KEY
# Secret: the key itself. Read from the environment only, never logged.
CLINE_API_KEY=
# Output-token floor for that model (hidden reasoning uses most of the budget).
ARP_HOSTED_MAX_TOKENS=1000
# Shared reference-cost (Pass) and usage log path; not a spend limit.
CLINE_USAGE_LEDGER=

# --- Research tools (M3, ADR-0007) ---
# Live HTTP fetch is off by default; when on, only allowlisted hosts.
ARP_ALLOW_LIVE_FETCH=false
# Comma-separated host names, e.g. en.wikipedia.org,arxiv.org
ARP_FETCH_ALLOWLIST=
